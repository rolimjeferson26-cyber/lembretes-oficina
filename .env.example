# Copia este ficheiro para ".env" e preenche.
# O ficheiro .env NUNCA vai para o GitHub (está no .gitignore).

NOME_OFICINA=Oficina Exemplo
EMAIL_OFICINA=oficina@exemplo.pt
FICHEIRO_CLIENTES=dados_exemplo/clientes.xlsx

# Dias de antecedência
DIAS_AVISO_OFICINA=30
DIAS_AVISO_CLIENTE=15

# Fase 2: avisar também os clientes (só os que deram consentimento)
AVISAR_CLIENTES=true

# true = não envia nada, grava os emails na pasta emails_teste/
# Muda para false SÓ depois de veres os testes e o cliente aprovar.
MODO_TESTE=true

# Servidor de email (exemplo Gmail). Usa uma SENHA DE APLICAÇÃO, nunca a senha normal.
SMTP_HOST=smtp.gmail.com
SMTP_PORTA=587
SMTP_UTILIZADOR=
SMTP_SENHA=
